# MongoDB Atlas connection string (include the database name)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inbounderz_workhub?retryWrites=true&w=majority"

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET="replace-me"
# Public base URL of the app (used for password reset links)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Initial Super Admin bootstrap (used ONLY by `npm run seed`)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@inbounderz.com"
SUPER_ADMIN_PASSWORD="change-this-strong-password"
SUPER_ADMIN_EMPLOYEE_ID="IBZ-0001"

# Optional: enables GET /api/cron/reminders for an external scheduler
# (send "Authorization: Bearer <CRON_SECRET>"). Generate with: openssl rand -hex 32
# CRON_SECRET=""

# Optional: where uploaded files are stored (default ./storage/uploads)
# STORAGE_DIR=""
